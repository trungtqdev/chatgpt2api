# ============================================
# ChatGPT2API - Cấu hình biến môi trường mẫu
# ============================================

# Khóa xác thực (Bắt buộc)
CHATGPT2API_AUTH_KEY=your_secret_key_here

# URL cơ sở (Tùy chọn, dùng để tạo đường dẫn ảnh)
# CHATGPT2API_BASE_URL=https://apikeygpt.pagee.io.vn

# ============================================
# Cấu hình lưu trữ (Storage Backend)
# ============================================

# Loại lưu trữ (Tùy chọn: json, sqlite, postgres, git)
# Mặc định: json
STORAGE_BACKEND=json

# ============================================
# Cấu hình cơ sở dữ liệu (Khi STORAGE_BACKEND=sqlite/postgres)
# ============================================

# Ví dụ PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Ví dụ Supabase
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# Ví dụ SQLite (Mặc định dùng data/accounts.db nếu không chỉ định)
# DATABASE_URL=sqlite:///app/data/accounts.db

# ============================================
# Cấu hình kho lưu trữ Git (Khi STORAGE_BACKEND=git)
# ============================================

# Địa chỉ kho Git (Bắt buộc)
# GIT_REPO_URL=git@github.com:your-username/your-private-repo.git

# Token truy cập Git (Bắt buộc)
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Nhánh Git (Tùy chọn, mặc định: main)
# GIT_BRANCH=main

# Đường dẫn file trong kho Git (Tùy chọn, mặc định: accounts.json)
# GIT_FILE_PATH=accounts.json
